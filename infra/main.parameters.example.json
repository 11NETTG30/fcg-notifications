    "acrLoginServer":           { "value": "fcgnotifications.azurecr.io" },
    "userAssignedIdentityId":   { "value": "/subscriptions/<sub-id>/resourceGroups/<rg>/providers/Microsoft.ManagedIdentity/userAssignedIdentities/fcg-aca-identity" },
    "rabbitMqConnectionString": { "value": "amqp://guest:guest@rabbitmq.example.com:5672/" },
